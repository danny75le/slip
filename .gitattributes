# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicit text files
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.svg      text eol=lf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.pdf      binary

# Lockfiles - never normalize, treat as text
package-lock.json text eol=lf -diff
yarn.lock         text eol=lf -diff
pnpm-lock.yaml    text eol=lf -diff
